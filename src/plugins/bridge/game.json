{
  "schema": "mental-deck-game/v1",
  "game": {"id":"mental_deck.game.bridge","name":"Contract Bridge","version":"0.10.0"},
  "players": {"min":4,"max":4},
  "deck": {"builtin":"standard-52"},
  "zones": [
    {"id":"hand:{player}","name":"{player_name} Hand","owner":"{player}","ordering":"UNORDERED","visibility":"OWNER_ONLY","controller_policy":"DELEGATED"},
    {"id":"current_trick","name":"Current Trick","owner":"shared","ordering":"ORDERED","visibility":"PUBLIC","controller_policy":"SHARED"},
    {"id":"completed_tricks","name":"Completed Tricks","owner":"shared","ordering":"ORDERED","visibility":"PUBLIC","controller_policy":"SHARED"}
  ],
  "setup": [{"op":"DEAL_ROUND_ROBIN","to":"hand:{player}","count_per_player":13}],
  "mechanicalActions": [
    {
      "id":"play_card",
      "parameters":{"hand_player_id":{"type":"ROSTER_PLAYER_ID"},"card":{"type":"CARD_REF"}},
      "steps":[{"op":"MOVE_REVEAL_PUBLIC","from":"hand:{hand_player_id}","source_access":"CONTROLLED","to":"current_trick","selection":{"type":"BY_HANDLE","param":"card"},"reveal":"PUBLIC"}]
    },
    {
      "id":"grant_hand_control",
      "parameters":{"controller_player_id":{"type":"ROSTER_PLAYER_ID"}},
      "steps":[{"op":"GRANT_CONTROL","from":"hand:{actor}","action_scope":["play_card"]}]
    }
  ],
  "gameEvents": [
    {"id":"pass","parameters":{}},
    {"id":"bid","parameters":{"level":{"type":"INTEGER","min":1,"max":7},"denomination":{"type":"STRING","enum":["clubs","diamonds","hearts","spades","notrump"]}}},
    {"id":"double","parameters":{}},
    {"id":"redouble","parameters":{}}
  ],
  "modules": {"rules":"./ruleAdvisor.ts","client":"./client.ts","ui":"./ui.tsx"}
}
